# Local Postgres (see docker-compose.yml: `docker compose up db`)
DATABASE_URL="postgresql://readingroom:readingroom@localhost:5432/readingroom"
JWT_SECRET="replace-this-with-a-long-random-secret"
PORT=4100
# Optional production bootstrap account. Set both values or neither.
# INITIAL_DESK_EMAIL="desk@example.com"
# INITIAL_DESK_PASSWORD="use-a-random-password-at-least-16-characters"
